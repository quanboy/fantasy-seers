# Local docker-compose secrets. Copy to `.env` and fill in real values.
# `.env` is gitignored and read automatically by docker-compose.
# These are REQUIRED — docker-compose now fails fast if they are unset
# (no hardcoded fallbacks are baked into the compose file anymore).

# Postgres password for the local db container.
POSTGRES_PASSWORD=change-me-locally

# JWT signing secret. Must be at least 48 bytes (HMAC-SHA384).
# Generate one with:  openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string-at-least-48-bytes

# Browser origins allowed to call the local backend.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Invite code required to register. Leave empty to allow open registration.
# Set this on Railway to gate who can join your league.
REGISTRATION_INVITE_CODE=

# Optional overrides for the local-only demo account created by docker-compose.
# These values are intentionally public and must never be used in production.
DEMO_ACCOUNT_USERNAME=demo
DEMO_ACCOUNT_EMAIL=demo@local.fantasyseers.invalid
DEMO_ACCOUNT_PASSWORD=demo-only-password

# Optional: Sentry DSN (leave empty to disable error monitoring locally).
SENTRY_DSN=
